@article{bankole2026_electrifying_paratransit_ssa,
  title = {Electrifying Paratransit in Sub-{{Saharan Africa}}: {{Perspectives}} from Practitioners},
  shorttitle = {Electrifying Paratransit in Sub-{{Saharan Africa}}},
  author = {Bankole, Shukurat Omotola and Donaldson, Daniel L. and Dissanayake, Dilum and Sakamoto Ferranti, Emma Jayne},
  year = 2026,
  month = jan,
  journal = {Transportation Research Part D: Transport and Environment},
  volume = {150},
  pages = {105113},
  issn = {13619209},
  doi = {10.1016/j.trd.2025.105113},
  urldate = {2025-11-22},
  abstract = {The need for sustainable transport in sub-Saharan Africa (SSA) continues to intensify due to continuous growth of urbanisation. Electrifying public transport (PT) is a path to achieving this but the means to enable this in SSA is not clear. This study explores the opportunities for electrifying the prevalent public transport system (paratransit) within the broader transport context in SSA through interviews with experts. Six important thematic areas were identified as ``transport structure'', ``usage culture'', ``economy'', ``environment'', ``infrastructure'', and ``regulations and incentives''. Findings reveal similarities in the challenges associated to transport formalisation and electrification, while emphasising the significance of transport and electrical power dynamics in electrification. Though countries in SSA share similarities in transport and electrical power dynamics, considerable differences exist, necessitating individual research in areas of such considerable differences. This study will be beneficial to planners and policymakers in understanding important areas of PT electrification and strategy transfer within SSA.},
  langid = {english},
}

@article{sello2026_ekamva_performance,
  title = {Empirical Performance Assessment of {{South Africa}}'s First Commercial Electric Minibus Taxi},
  author = {Sello, Joshua T. and Abraham, Chris J. and Lacock, Stephan and Booysen, M. J. (Thinus)},
  year = 2026,
  month = dec,
  journal = {African Transport Studies},
  volume = {4},
  pages = {100117},
  issn = {2950-1962},
  doi = {10.1016/j.aftran.2026.100117},
  urldate = {2026-09-29},
  abstract = {South Africa's minibus taxi fleet serves over 15 million daily passengers and is almost entirely diesel-powered, making electrification a critical lever for reducing emissions and fuel costs. This study provides the first empirical performance assessment (encompassing energy consumption, range, and charging behaviour) of the Higer H5C EV minibus --- the first commercially available electric minibus taxi in South Africa and the vehicle planned for the country's inaugural eKamva pilot. Using real-world vehicle telemetry from 33 trips, we construct an empirical energy consumption map that captures how energy consumption varies continuously with speed and tractive force, including the effects of payload, gradient, and regenerative braking. Leave-one-trip-out validation produced median finite-prediction coverage of 98.8\%, a median sample-level mean absolute error of 0.191kWh/km, and a median absolute trip-energy error of 6.22\%; the map outperformed a constant-consumption baseline for every held-out trip. Applying the map to the modified WLTC Class 3a cycle on flat terrain yielded consumption rates of 0.289kWh/km for the unloaded vehicle and 0.333kWh/km at full payload, corresponding to idealised 100\% depth-of-discharge ranges of 244 km and 211 km, respectively. Across measured trips, the unweighted mean of the 33 trip-specific consumption rates was 0.382kWh/km, corresponding to a range of 184 km at 100\% depth of discharge, though this rises to 228 km at the 25th percentile, demonstrating strong sensitivity to operating conditions. A motor-temperature fault was recorded in the test log during one hilly trip, warranting further investigation under sustained-gradient operation. Charging simulations using a lithium iron phosphate battery model show a pronounced difference in charge recovery time between 7.2 kW and 22 kW, but a much smaller gain beyond 22 kW, with practical implications for depot infrastructure sizing. These findings provide an empirical baseline to support route planning and charging infrastructure decisions as South Africa transitions to electric paratransit.},
  keywords = {Charging performance,Electric vehicles,Energy consumption,Energy consumption mapping,Minibus taxi,Paratransit,South Africa},
}

