@article{traag2019_louvain_to_leiden,
  title = {From {{Louvain}} to {{Leiden}}: Guaranteeing Well-Connected Communities},
  shorttitle = {From {{Louvain}} to {{Leiden}}},
  author = {Traag, V. A. and Waltman, L. and {van Eck}, N. J.},
  year = 2019,
