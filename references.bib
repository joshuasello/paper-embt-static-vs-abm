@misc{sello2026_gau_mbt_distance,
  type = {{{SSRN Scholarly Paper}}},
  title = {Daily {{Distance}}, {{Activity}}, {{Mobility Shifts}} among {{Observed Minibus Taxis}} in {{Gauteng}}},
  author = {Sello, Joshua T. and Booysen, M. J.},
  year = 2026,
  month = sep,
  number = {7505038},
  eprint = {7505038},
  publisher = {Social Science Research Network},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.7505038},
  urldate = {2026-10-14},
  abstract = {Minibus taxis provide a substantial share of daily public transport in South Africa, yet large-sample evidence on how far and how long individual vehicles operate remains limited. This paper uses 174.9 million GPS records from December 2025 to quantify daily distance, movement duration, operating span, active vehicles, time-of-day structure, and persistence among observed minibus taxis. Cleaned, time-ordered observations were aggregated into operational vehicle-days. The Gauteng selection contained 121,739 vehicle-days from 5,020 vehicles between 1 and 31 December; 100,006 vehicle-days from 4,836 vehicles met the analytical criteria. Median daily distance declined from 166 km during 1-25 December to 142 km during 26-31 December, median movement duration declined from 6.1 to 5.1 hours, and median operating span declined from 14.6 to 13.8 hours. The late-period morning profile was delayed, but the evening endpoint changed little: median movement start shifted from 07:19 to 07:43 and median end from 21:58 to 21:48. Within-vehicle day-today variation accounted for 65.2\% of distance variation and 75.8\% of operating-span variation. Nevertheless, extremedistance activity was concentrated: a vehicle-day above the fleet-wide 90th percentile was 6.1 times more likely after another such day than after a non-tail day. These findings support distributional and risk-based transport planning.},
  archiveprefix = {Social Science Research Network},
  langid = {english},
  keywords = {Daily Distance,Gauteng,GPS Telemetry,Minibus Taxi,Paratransit,Vehicle-Day},
}

@misc{watanabe2026_tpe,
  title = {Tree-{{Structured Parzen Estimator}}: {{Understanding Its Algorithm Components}} and {{Their Roles}} for {{Better Empirical Performance}}},
  shorttitle = {Tree-{{Structured Parzen Estimator}}},
  author = {Watanabe, Shuhei},
  year = 2026,
  month = may,
  number = {arXiv:2304.11127},
  eprint = {2304.11127},
  primaryclass = {cs.LG},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2304.11127},
  urldate = {2026-06-21},
  abstract = {Recent scientific advances require complex experiment design, necessitating the meticulous tuning of many experiment parameters. Tree-structured Parzen estimator (TPE) is a widely used Bayesian optimization method in recent parameter tuning frameworks such as Hyperopt and Optuna. Despite its popularity, the roles of each control parameter in TPE and the algorithm intuition have not been discussed so far. The goal of this paper is to identify the roles of each control parameter and their impacts on parameter tuning based on the ablation studies using diverse benchmark datasets. The recommended setting concluded from the ablation studies is demonstrated to improve the performance of TPE. Our TPE implementation used in this paper is available at https://github.com/nabenabe0928/tpe/tree/single-opt. OptunaHub now provides our standalone TPE implementation at https://hub.optuna.org/samplers/tpe\_tutorial/.},
  archiveprefix = {arXiv},
  keywords = {Computer Science - Machine Learning},
}


