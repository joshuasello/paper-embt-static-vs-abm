@article{bischoff2014_etaxi_abm,
  title = {Agent-Based {{Simulation}} of {{Electric Taxicab Fleets}}},
  author = {Bischoff, Joschka and Maciejewski, Michal},
  year = 2014,
  month = jan,
  journal = {Transportation Research Procedia},
