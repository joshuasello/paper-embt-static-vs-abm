dashed=0;shape=mxgraph.ios7.icons.battery;" vertex="1" parent="1"><mxGeometry x="332" y="78" width="20" height="12" as="geometry"/></mxCell><mxCell id="sd-28" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#97D077;" vertex="1" parent="1"><mxGeometry x="332" y="78" width="13" height="12" as="geometry"/></mxCell><mxCell id="sd-29" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;labelBorderColor=#82b366;imageBackground=default;" vertex="1" parent="1"><mxGeometry x="356" y="75" width="36" height="15" as="geometry"/></mxCell><mxCell id="sd-30" value="" style="shape=mxgraph.basic.arc;html=1;startAngle=0.3;endAngle=0.25;endArrow=block;endFill=1;endSize=3;strokeWidth=1.2;" vertex="1" parent="1"><mxGeometry x="394" y="75" width="14" height="14" as="geometry"/></mxCell><mxCell id="sd-31" value="&amp;bull; &lt;b&gt;Movement observed and fixed&lt;/b&gt;&lt;br&gt;&amp;bull; Observed EVs: the qualified vehicles, replayed on 8 term weekdays&lt;br&gt;&amp;bull; Charging in recorded dwells of 10&amp;nbsp;min or more at a hub&lt;br&gt;&amp;bull; Each date repeated to a steady state: vehicle-days viable, below reserve or stranded&lt;br&gt;&amp;bull; No passengers and no other vehicles&lt;br&gt;&lt;i&gt;Measures:&lt;/i&gt; stranded share, peak site load" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="192" y="96" width="212" height="110" as="geometry"/></mxCell><mxCell id="sd-32" value="&lt;b&gt;Same in both models&lt;/b&gt;&lt;br&gt;Qualified vehicles of the community&lt;br&gt;EV values: 70.47&amp;nbsp;kWh, 0.38&amp;nbsp;kWh/km, \(0.2\,C\) reserve&lt;br&gt;Overnight charging at 3.7&amp;nbsp;kW&lt;br&gt;3 candidate hubs; designs \(\mathbf{x} = (N_1, N_2, N_3, P) \in \mathcal{X}\)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;arcSize=4;fillColor=#f5f5f5;strokeColor=default;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=8;" vertex="1" parent="1"><mxGeometry x="186" y="226" width="224" height="90" as="geometry"/></mxCell><mxCell id="sd-33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=0.75;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sd-32" target="sd-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sd-34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=0.75;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sd-18" target="sd-32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="168" y="366"/><mxPoint x="168" y="271.0"/></Array></mxGeometry></mxCell><mxCell id="sd-35" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;arcSize=3;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="186" y="332" width="224" height="152" as="geometry"/></mxCell><mxCell id="sd-36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=0.75;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sd-32" target="sd-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sd-37" value="&lt;b&gt;&lt;i&gt;Agent-based model \(M_A\)&lt;/i&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=8;fontSize=9;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="192" y="336" width="140" height="18" as="geometry"/></mxCell><mxCell id="sd-38" value="" style="html=1;verticalLabelPosition=bottom;align=center;verticalAlign=top;strokeWidth=2;strokeColor=#97D077;shadow=0;dashed=0;shape=mxgraph.ios7.icons.battery;" vertex="1" parent="1"><mxGeometry x="332" y="340" width="20" height="12" as="geometry"/></mxCell><mxCell id="sd-39" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fillColor=#97D077;" vertex="1" parent="1"><mxGeometry x="332" y="340" width="13" height="12" as="geometry"/></mxCell><mxCell id="sd-40" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;labelBorderColor=#82b366;imageBackground=default;" vertex="1" parent="1"><mxGeometry x="356" y="337" width="36" height="15" as="geometry"/></mxCell><mxCell id="sd-41" value="" style="shape=mxgraph.signs.healthcare.brain;html=1;pointerEvents=1;fillColor=#B85450;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="394" y="336" width="15" height="15" as="geometry"/></mxCell><mxCell id="sd-42" value="&amp;bull; &lt;b&gt;Movement from driver decisions:&lt;/b&gt; route, hold-back, idling, charging&lt;br&gt;&amp;bull; EV agents (the qualified vehicles) and ICE competitors on the same routes&lt;br&gt;&amp;bull; Passenger demand scaled to the CITP boardings&lt;br&gt;&amp;bull; ICE baseline calibrated to the observed duty cycle&lt;br&gt;&amp;bull; Each EV run paired with an ICE run of the same seed&lt;br&gt;&lt;i&gt;Measures:&lt;/i&gt; EV passenger change \(\Delta_{\mathrm{EV}}\), expired share, wait, peak site load" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=8;fontSize=9;" vertex="1" parent="1"><mxGeometry x="192" y="358" width="212" height="122" as="geometry"/></mxCell><mxCell id="sd-43" value="Every design evaluated: exact Pareto front" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;fillColor=#f5f5f5;strokeColor=default;fontColor=#333333;fontSize=8;" vertex="1" parent="1"><mxGeometry x="446" y="74" width="144" height="30" as="geometry"/></mxCell><mxCell id="sd-44" value="Rule: at least 95% of the highest not-stranded share; then lowest peak, then installed power" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;fillColor=#f5f5f5;strokeColor=default;fontColor=#333333;fontSize=8;" vertex="1" parent="1"><mxGeometry x="446" y="114" width="144" height="52" as="geometry"/></mxCell><mxCell id="sd-45" value="Selected design \(\mathbf{x}^\star_R\)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;arcSize=0;fillColor=#ffe6cc;strokeColor=default;fontSize=9;" vertex="1" parent="1"><mxGeometry x="446" y="176" width="144" height="26" as="geometry"/></mxCell><mxCell id="sd-46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=0.75;exitX=1;exitY=0.136;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="sd-25" target="sd-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sd-47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=0.75;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sd-43" target="sd-44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sd-48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=blockThin;endFill=1;strokeWidth=0.75;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sd-44" target="sd-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sd-49" value="&lt;b&gt;Representation check&lt;/b&gt;&lt;br&gt;The \(M_R\) rule applied to the simulated ICE movement of \(M_A\) (5 seeds)" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=0.5;arcSize=0;fillColor=#dae8fc;strokeColor=default;dashed=1;dashPattern=8 8;fontSize=8;" vertex="1" parent="1"><mxGeometry x="44